{
  "name": "claviron/laravel",
  "version": "0.1.3",
  "description": "Claviron drivers and adapters for Laravel: cache, sessions, database, broadcasting, queue, schedule, and the Octane client",
  "type": "library",
  "license": "MIT",
  "require": {
    "claviron/sapi": "0.1.1",
    "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
    "illuminate/broadcasting": "^11.0 || ^12.0 || ^13.0",
    "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^11.0 || ^12.0 || ^13.0",
    "illuminate/database": "^11.0 || ^12.0 || ^13.0",
    "illuminate/log": "^11.0 || ^12.0 || ^13.0",
    "illuminate/notifications": "^11.0 || ^12.0 || ^13.0",
    "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
    "illuminate/session": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "monolog/monolog": "^3.0",
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "Lumenize\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lumenize\\Providers\\LumenizeProvider",
        "Lumenize\\Providers\\AuthServiceProvider",
        "Lumenize\\Providers\\BroadcastingProvider",
        "Lumenize\\Providers\\CacheServiceProvider",
        "Lumenize\\Providers\\SessionServiceProvider",
        "Lumenize\\Providers\\DatabaseServiceProvider",
        "Lumenize\\Providers\\QueueServiceProvider",
        "Lumenize\\Providers\\ScheduleServiceProvider",
        "Lumenize\\Providers\\LogServiceProvider"
      ]
    }
  },
  "suggest": {
    "laravel/octane": "^2.0, for Lumenize\\Octane\\ClavironClient (the application model's request client)"
  }
}
