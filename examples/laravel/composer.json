{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lumenize/laravel-example",
    "description": "A local Laravel application for developing Lumenize",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo_sqlite": "*",
        "claviron/laravel": "0.1.0",
        "laravel/framework": "^13.35",
        "laravel/octane": "^2.21"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php tests/smoke.php"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
